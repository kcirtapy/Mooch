# Copy to .env and fill in. Never commit this file.

# From platform.claude.com/settings/keys -> Create key. Required.
ANTHROPIC_API_KEY=sk-ant-...

# Gmail App Password, 16 chars, no spaces. NOT your Google password.
# Only needed once the email source is enabled.
MOOCH_IMAP_PASSWORD=

# Burner Instagram account password. Only needed for `mooch ig-login`;
# you can clear it once the session file exists.
MOOCH_IG_PASSWORD=
